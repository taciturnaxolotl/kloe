# Inference provider (OpenAI-compatible, e.g. Hyper).
# Leave HYPER_API_KEY empty to use the built-in mock provider (no network).
HYPER_BASE_URL=
HYPER_API_KEY=
HYPER_MODEL=
# 'compatible' for non-OpenAI endpoints, 'strict' for api.openai.com
HYPER_COMPATIBILITY=compatible

# Server
PORT=3000
# Path to the sqlite database file
KLOE_DB=data/kloe.db
