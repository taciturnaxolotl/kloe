{
  "$schema": "./kloe.schema.json",
  "server": {
    "port": 3000,
    "dbPath": "data/kloe.db"
  },
  "blobs": {
    "backend": "fs",
    "path": "data/blobs",
    "maxBytes": 26214400,
    "s3": {
      "bucket": "kloe",
      "endpoint": "http://localhost:9000",
      "accessKeyId": "$S3_ACCESS_KEY_ID",
      "secretAccessKey": "$S3_SECRET_ACCESS_KEY",
      "prefix": "blobs/"
    }
  },
  "search": {
    "provider": "ceramic",
    "apiKey": "$CERAMIC_API_KEY",
    "maxResults": 5
  },
  "research": {
    "enabled": true,
    "maxAgents": 6,
    "maxSteps": 400,
    "maxSources": 500,
    "timeoutMs": 1800000
  },
  "fetch": {
    "enabled": true,
    "maxBytes": 2097152,
    "maxChars": 50000,
    "timeoutMs": 15000,
    "allowPrivate": false
  },
  "auth": {
    "enabled": false,
    "issuer": "https://indiko.dunkirk.sh",
    "baseUrl": "https://kloe.dunkirk.sh",
    "allowedSubs": [],
    "sessionTtlDays": 30,
    "appName": "kloe",
    "roles": {
      "owner": {
        "admin": true,
        "sandbox": true,
        "publish": true,
        "models": ["*"],
        "search": ["*"],
        "subs": ["https://you.example/"]
      },
      "guest": {
        "models": ["hyper/*"],
        "search": ["duckduckgo"],
        "usdPerDay": 0.5,
        "tokensPerDay": 0
      }
    }
  },
  "prompt": {
    "name": "Kloe",
    "tagline": "your homelab chat",
    "personality": "You are warm, direct, and unpretentious.",
    "preferences": "Prefer metric units and 24-hour time.",
    "math": true,
    "noEmoji": false,
    "contextFiles": []
  },
  "providers": [
    {
      "id": "anthropic",
      "apiKey": "$ANTHROPIC_API_KEY",
      "maxConcurrency": 4
    },
    {
      "id": "openrouter",
      "apiKey": "$OPENROUTER_API_KEY",
      "maxConcurrency": 8
    },
    {
      "id": "hyper",
      "apiKey": "$HYPER_API_KEY",
      "apiEndpoint": "https://hyper.charm.land/v1",
      "type": "hyper"
    },
    {
      "id": "ollama",
      "apiEndpoint": "http://localhost:11434/v1",
      "type": "openai-compat"
    }
  ]
}
